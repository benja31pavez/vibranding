# Variables de entorno del servidor (Cloudflare Workers). Solo nombres: nunca
# pongas valores reales en este archivo.

# --- Flow (cobros online, flow.cl) ---
# Las tres son obligatorias. Si falta alguna, Flow se considera NO configurado
# y la plataforma no ofrece "Generar link de pago".
# Credenciales del comercio (panel de Flow → Integraciones).
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Ambiente de Flow. Sin valor por defecto a propósito.
#   producción → https://www.flow.cl/api
#   pruebas    → https://sandbox.flow.cl/api
FLOW_API_URL=

# --- Administradores de la plataforma ---
# Emails (confirmados) separados por coma que ven Salud y diagnósticos.
PLATFORM_ADMIN_EMAILS=

# --- Google Ads (solo lectura de campañas) ---
# Cliente OAuth de tipo "Aplicación web" del proyecto de Google Cloud que tiene
# habilitada la Google Ads API (Cloud Console → APIs y servicios → Credenciales).
# URI de redirección autorizada: <PUBLIC_SITE_URL>/api/public/google/oauth/callback
# Si faltan CLIENT_ID o CLIENT_SECRET, la sección "Google Ads" muestra
# "No configurado" y la ingesta diaria no hace nada.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Opcional. Desde el 9-sep-2026 Google ignora el developer token: el nivel de
# acceso (Explorer/Basic/Standard) lo da el proyecto de Google Cloud. Se envía
# solo si está definido (compatibilidad con integraciones antiguas).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Opcional. ID (10 dígitos, con o sin guiones) de la cuenta administradora
# (MCC) de la agencia: se revisa siempre al buscar cuentas de clientes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Ya usada por Meta: origen público canónico (ej. https://vibranding.pro).
# PUBLIC_SITE_URL=
